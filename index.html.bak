      </div>
      <div style="padding:0 16px 24px;">
        <div style="text-align:center;margin-bottom:20px;">
          <div class="av" style="width:80px;height:80px;font-size:32px;margin:0 auto 10px;" id="eap">S</div>
          <button class="btn bg sm" onclick="upPh()">📷 Change Photo</button>
        </div>
        <div class="fg"><label class="fl">Full Name *</label><input type="text" id="epn" placeholder="Your full name"></div>
        <div class="fg"><label class="fl">Bio / About</label><textarea id="epb" rows="3" placeholder="Describe your experience and expertise…"></textarea></div>
        <div class="g2">
          <div class="fg"><label class="fl">City *</label><input type="text" id="epc" placeholder="Mumbai"></div>
          <div class="fg"><label class="fl">Locality</label><input type="text" id="epl" placeholder="Andheri"></div>
        </div>
        <div class="fg"><label class="fl">Service Area</label><input type="text" id="epa" placeholder="Andheri, Goregaon, Borivali"></div>
        <div class="fg"><label class="fl">Skills (comma separated)</label><input type="text" id="eps" placeholder="Plumbing, Pipe Fitting, Drain Cleaning"></div>
        <div class="fg"><label class="fl">Category</label><select id="epcat"><option>Plumbing</option><option>Electrical</option><option>Carpentry</option><option>Painting</option><option>Cleaning</option><option>Mechanic</option><option>Delivery</option><option>Gardening</option><option>Home Repair</option><option>Construction</option><option>Other</option></select></div>
        <div class="g2">
          <div class="fg"><label class="fl">Experience (years)</label><input type="number" id="epe" min="0" placeholder="5"></div>
          <div class="fg"><label class="fl">Expected Wage (₹)</label><input type="number" id="epw" placeholder="600"></div>
        </div>
        <div class="fg"><label class="fl">Wage Unit</label><select id="epwu"><option>per day</option><option>per hour</option><option>per month</option><option>per job</option></select></div>
        <div class="fg"><label class="fl">Languages (comma separated)</label><input type="text" id="epla" placeholder="Hindi, Marathi, English"></div>
        <div class="fg"><label class="fl">Phone (visible on profile)</label><input type="tel" id="epph" placeholder="+91 98760 11111"></div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
          <input type="checkbox" id="epav" style="width:auto;" checked>
          <label for="epav" style="font-size:13px;cursor:pointer;">Currently available for work</label>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="btn bg" style="flex:1;justify-content:center;" onclick="gB()">Cancel</button>
          <button class="btn bp" style="flex:1;justify-content:center;" onclick="sWP()">Save Profile ✓</button>
        </div>
      </div>
