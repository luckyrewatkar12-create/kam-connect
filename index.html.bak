          <div class="ir" onclick="oRpt()" style="cursor:pointer;"><span class="irl">Report a Problem</span><span style="color:var(--tx3);">→</span></div>
          <div class="ir" onclick="oPrv()" style="cursor:pointer;"><span class="irl">Privacy Policy</span><span style="color:var(--tx3);">→</span></div>
          <div class="ir" onclick="oTrm()" style="cursor:pointer;"><span class="irl">Terms of Service</span><span style="color:var(--tx3);">→</span></div>
        </div>
