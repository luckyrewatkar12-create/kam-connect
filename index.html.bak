          <div style="display:flex;gap:8px;">
            <button class="btn bp sm" id="len" onclick="sAL('en',this)">English</button>
            <button class="btn bg sm" id="lhi" onclick="sAL('hi',this)">हिंदी</button>
            <button class="btn bg sm" id="lmr" onclick="sAL('mr',this)">मराठी</button>
          </div>
        </div>
