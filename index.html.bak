<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KAM CONNECT — Local Services &amp; Hiring Platform</title>
<style>
:root{
  --bg:#0D1220;--sf:#17202F;--s2:#1E2C40;
  --p:#40CAD7;--pd:#2BAAB6;--sec:#7C5CD8;--acc:#FFB830;
  --ok:#34D399;--wn:#FBBF24;--er:#F87171;--info:#60A5FA;
  --tx:#FFFFFF;--tx2:#8DA4BF;--tx3:#4A6580;--br:#243348;
  --r:14px;--rs:8px;--rl:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--tx);font-family:"Segoe UI",system-ui,sans-serif;font-size:14px;overflow-x:hidden}
a{color:var(--p);text-decoration:none}
input,textarea,select{background:var(--s2);color:var(--tx);border:1.5px solid var(--br);border-radius:var(--rs);padding:12px 14px;font-family:inherit;font-size:14px;width:100%;outline:none;transition:.2s}
input:focus,textarea:focus,select:focus{border-color:var(--p)}
select option{background:var(--s2)}
button{cursor:pointer;font-family:inherit}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:var(--r);font-weight:600;font-size:14px;border:none;transition:.18s}
.bp{background:var(--p);color:#000}.bp:hover{background:var(--pd);transform:translateY(-1px)}
.bo{background:transparent;color:var(--p);border:1.5px solid var(--p)}.bo:hover{background:rgba(64,202,215,.1)}
.bg{background:transparent;color:var(--tx2);border:1.5px solid var(--br)}.bg:hover{border-color:var(--p);color:var(--p)}
.bd{background:var(--er);color:#fff}
.bsuc{background:var(--ok);color:#000}
.sm{padding:7px 14px;font-size:12px;border-radius:var(--rs)}
.fw{width:100%;justify-content:center}
.btn:disabled{opacity:.5;pointer-events:none}
.card{background:var(--sf);border:1px solid var(--br);border-radius:var(--r);padding:16px;transition:.15s}
.card:hover{border-color:rgba(64,202,215,.25)}
.bdg{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
.bdi{background:rgba(96,165,250,.15);color:var(--info)}
.bdok{background:rgba(52,211,153,.15);color:var(--ok)}
.bdw{background:rgba(251,191,36,.15);color:var(--wn)}
.bder{background:rgba(248,113,113,.15);color:var(--er)}
.bds{background:rgba(124,92,216,.15);color:var(--sec)}
.bdp{background:rgba(64,202,215,.15);color:var(--p)}
.bdm{background:rgba(74,101,128,.15);color:var(--tx3)}
.chip{display:inline-flex;align-items:center;padding:4px 10px;background:var(--s2);border:1px solid var(--br);border-radius:20px;font-size:12px;color:var(--tx2)}
.av{border-radius:50%;background:var(--s2);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--p);flex-shrink:0}
.stars{color:var(--acc);font-size:13px}
.pg{display:none;flex-direction:column;min-height:100vh}.pg.on{display:flex}
.tc{display:none}.tc.on{display:block}
.topb{position:sticky;top:0;z-index:100;background:var(--bg);border-bottom:1px solid var(--br);padding:10px 16px;display:flex;align-items:center;gap:10px}
.logo{font-size:18px;font-weight:800;background:linear-gradient(135deg,var(--p),var(--sec));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sbx{flex:1;display:flex;align-items:center;background:var(--s2);border:1.5px solid var(--br);border-radius:10px;padding:0 12px;gap:8px}
.sbx input{border:none;background:transparent;padding:9px 0;font-size:13px;width:100%}
.bnav{position:fixed;bottom:0;left:0;right:0;z-index:100;background:var(--sf);border-top:1px solid var(--br);display:flex;padding:6px 0 10px}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px;cursor:pointer;color:var(--tx3);font-size:10px;transition:.15s;position:relative}
.ni .ic{font-size:22px}.ni.on{color:var(--p)}
.nbg{position:absolute;top:2px;right:20%;background:var(--er);color:#fff;font-size:9px;font-weight:700;border-radius:10px;padding:1px 5px;min-width:16px;text-align:center}
.pc{flex:1;overflow-y:auto;padding-bottom:80px}
.hs{background:linear-gradient(160deg,var(--sf),var(--bg));padding:20px 16px 16px}
.hs2{display:flex;align-items:center;background:var(--s2);border:1.5px solid var(--br);border-radius:12px;padding:4px 4px 4px 14px;gap:8px}
.hs2 input{border:none;background:transparent;flex:1;padding:8px 0;font-size:14px}
.qa{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:16px}
.qi{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer}
.qic{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px}
.qil{font-size:11px;font-weight:600;text-align:center;color:var(--tx2)}
.cg{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:0 16px}
.ci{display:flex;flex-direction:column;align-items:center;gap:6px;background:var(--sf);border:1px solid var(--br);border-radius:12px;padding:12px 8px;cursor:pointer;transition:.15s}
.ci:hover{border-color:var(--p);transform:translateY(-2px)}
.stit{font-size:16px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}
.sx{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}
.sx::-webkit-scrollbar{display:none}
.wc{background:var(--sf);border:1px solid var(--br);border-radius:var(--r);padding:14px;cursor:pointer;transition:.15s;margin-bottom:10px}
.wc:hover{border-color:rgba(64,202,215,.3);transform:translateY(-2px)}
.jc{background:var(--sf);border:1px solid var(--br);border-radius:var(--r);padding:14px;cursor:pointer;transition:.15s;margin-bottom:10px}
.jc:hover{border-color:rgba(64,202,215,.3)}
.fr{display:flex;gap:8px;padding:10px 16px;overflow-x:auto;scrollbar-width:none}
.fr::-webkit-scrollbar{display:none}
.fc{flex-shrink:0;padding:6px 14px;background:var(--sf);border:1.5px solid var(--br);border-radius:20px;font-size:12px;font-weight:600;color:var(--tx2);cursor:pointer;transition:.15s;white-space:nowrap}
.fc.on{background:rgba(64,202,215,.15);border-color:var(--p);color:var(--p)}
.mo{display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.7);align-items:flex-end;justify-content:center}
.mo.on{display:flex}
.md{background:var(--sf);border-radius:var(--rl) var(--rl) 0 0;width:100%;max-width:540px;max-height:90vh;overflow-y:auto;padding:20px;animation:su .25s ease}
@keyframes su{from{transform:translateY(100%)}to{transform:translateY(0)}}
.mhd{width:40px;height:4px;background:var(--br);border-radius:2px;margin:0 auto 16px}
.cls{background:var(--s2);border:none;color:var(--tx2);width:32px;height:32px;border-radius:50%;font-size:18px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.dh{background:linear-gradient(160deg,var(--s2),var(--sf));padding:20px 16px}
.bkb{display:inline-flex;align-items:center;gap:6px;color:var(--tx2);background:var(--s2);border:none;border-radius:var(--rs);padding:8px 12px;font-size:13px;cursor:pointer;margin-bottom:16px}
.bkb:hover{color:var(--p)}
.ir{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--br);font-size:13px}
.ir:last-child{border:none}.irl{color:var(--tx2);min-width:100px}.irv{font-weight:500;flex:1}
.fg{margin-bottom:14px}.fl{font-size:12px;font-weight:600;color:var(--tx2);margin-bottom:6px;display:block}
.fe{font-size:11px;color:var(--er);margin-top:4px;display:none}
.fg.er input,.fg.er select,.fg.er textarea{border-color:var(--er)}.fg.er .fe{display:block}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sg{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:16px}
.sc{background:var(--sf);border:1px solid var(--br);border-radius:var(--r);padding:14px}
.sc .sv{font-size:26px;font-weight:800;color:var(--p)}.sc .sl{font-size:12px;color:var(--tx2)}
.tbbar{display:flex;border-bottom:1px solid var(--br);overflow-x:auto;padding:0 16px;scrollbar-width:none}
.tbbar::-webkit-scrollbar{display:none}
.tbt{padding:11px 16px;font-size:13px;font-weight:600;color:var(--tx2);border:none;background:none;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:.15s}
.tbt.on{color:var(--p);border-bottom-color:var(--p)}
.otp{display:flex;gap:10px;justify-content:center}
.oi{width:48px;height:54px;text-align:center;font-size:20px;font-weight:700;border-radius:10px}
.cb{max-width:72%;padding:10px 14px;border-radius:14px;font-size:13px}
.cb.me{background:var(--p);color:#000;margin-left:auto;border-bottom-right-radius:4px}
.cb.th{background:var(--s2);border-bottom-left-radius:4px}
.ni2{display:flex;gap:12px;padding:14px 16px;border-bottom:1px solid var(--br);cursor:pointer;transition:.15s}
.ni2:hover{background:var(--s2)}.ni2.ur{background:rgba(64,202,215,.04)}
.cli{display:flex;gap:12px;padding:14px 16px;border-bottom:1px solid var(--br);cursor:pointer;align-items:center}
.cli:hover{background:var(--s2)}
.dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.dot.y{background:var(--ok)}.dot.n{background:var(--er)}
.avd{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600}
.avd.y{color:var(--ok)}.avd.n{color:var(--er)}
.rtb{padding:7px 18px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid var(--br);color:var(--tx2);transition:.15s}
.rtb.on{background:var(--p);color:#000;border-color:var(--p)}
.ph{background:linear-gradient(160deg,var(--s2),var(--sf));padding:24px 16px;text-align:center}
.rt{display:flex;gap:8px;justify-content:center;padding:12px 16px;border-bottom:1px solid var(--br)}
.is{padding:16px}
.ib{background:var(--sf);border:1px solid var(--br);border-radius:var(--r);padding:14px;margin-bottom:12px}
.ib h3{font-size:13px;font-weight:700;color:var(--tx2);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.ar{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
#tst{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--s2);color:var(--tx);padding:10px 20px;border-radius:20px;font-size:13px;font-weight:600;z-index:9999;display:none;border:1px solid var(--br);box-shadow:0 4px 20px rgba(0,0,0,.4);white-space:nowrap}
#tst.sh{display:block;animation:fiu .25s ease}
#tst.ok{border-color:var(--ok);color:var(--ok)}
#tst.er{border-color:var(--er);color:var(--er)}
@keyframes fiu{from{opacity:0;transform:translateX(-50%) translateY(10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
hr{border:none;border-top:1px solid var(--br);margin:12px 0}
.mt{margin-top:8px}.mt2{margin-top:16px}.mb{margin-bottom:8px}.mb2{margin-bottom:16px}
input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none}
@media(min-width:768px){
  .bnav,.topb{max-width:600px;left:50%;transform:translateX(-50%);border-left:1px solid var(--br);border-right:1px solid var(--br)}
  .pc{max-width:600px;margin:0 auto}
}
@media(max-width:500px){.g2{grid-template-columns:1fr}.qa{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<div id="tst"></div>

<!-- ═══════════════════ ONBOARDING ═══════════════════ -->
<div id="pob" class="pg on">
  <div style="flex:1;display:flex;flex-direction:column;">
    <div id="os0" style="display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;padding:40px 32px;text-align:center;">
      <div style="width:140px;height:140px;border-radius:36px;background:linear-gradient(135deg,#40CAD7,#2BAAB6);display:flex;align-items:center;justify-content:center;font-size:64px;margin-bottom:36px;">🔍</div>
      <div style="font-size:24px;font-weight:800;margin-bottom:12px;">Find Trusted Local Services</div>
      <div style="color:var(--tx2);font-size:15px;line-height:1.6;">Discover plumbers, electricians, painters and more near you — with real ratings and reviews.</div>
    </div>
    <div id="os1" style="display:none;flex:1;flex-direction:column;align-items:center;justify-content:center;padding:40px 32px;text-align:center;">
      <div style="width:140px;height:140px;border-radius:36px;background:linear-gradient(135deg,#7C5CD8,#5A3DBB);display:flex;align-items:center;justify-content:center;font-size:64px;margin-bottom:36px;">💼</div>
      <div style="font-size:24px;font-weight:800;margin-bottom:12px;">Discover Nearby Work</div>
      <div style="color:var(--tx2);font-size:15px;line-height:1.6;">Find daily-wage, part-time and full-time opportunities in your city. Apply with one tap.</div>
    </div>
    <div id="os2" style="display:none;flex:1;flex-direction:column;align-items:center;justify-content:center;padding:40px 32px;text-align:center;">
      <div style="width:140px;height:140px;border-radius:36px;background:linear-gradient(135deg,#FFB830,#E09010);display:flex;align-items:center;justify-content:center;font-size:64px;margin-bottom:36px;">🤝</div>
      <div style="font-size:24px;font-weight:800;margin-bottom:12px;">Connect &amp; Grow</div>
      <div style="color:var(--tx2);font-size:15px;line-height:1.6;">Employers find skilled workers. Workers build careers. Communities thrive together.</div>
    </div>
  </div>
  <div style="padding:0 24px 40px;">
    <div id="odd" style="display:flex;justify-content:center;gap:8px;margin-bottom:24px;">
      <div class="od" style="width:24px;height:8px;background:var(--p);border-radius:4px;transition:.3s;"></div>
      <div class="od" style="width:8px;height:8px;background:var(--s2);border-radius:4px;transition:.3s;"></div>
      <div class="od" style="width:8px;height:8px;background:var(--s2);border-radius:4px;transition:.3s;"></div>
    </div>
    <div style="display:flex;gap:8px;justify-content:center;margin-bottom:14px;">
      <button class="btn bg sm" onclick="skO()">Skip</button>
      <button class="btn bp" id="obn" style="flex:1;max-width:220px;justify-content:center;" onclick="nxO()">Continue</button>
    </div>
    <div style="display:flex;justify-content:center;gap:8px;">
      <button class="btn bg sm" onclick="sL('en')">EN</button>
      <button class="btn bg sm" onclick="sL('hi')">हिं</button>
      <button class="btn bg sm" onclick="sL('mr')">मर</button>
    </div>
  </div>
</div>

<!-- ═══════════════════ LOGIN ═══════════════════ -->
<div id="pli" class="pg">
  <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;">
    <div style="width:100%;max-width:420px;">
      <div style="text-align:center;margin-bottom:32px;">
        <div style="font-size:36px;font-weight:900;background:linear-gradient(135deg,var(--p),var(--sec));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">⚡ Kam Connect</div>
        <div style="color:var(--tx2);font-size:13px;margin-top:4px;">Connect. Work. Grow.</div>
      </div>
      <div style="font-size:20px;font-weight:700;margin-bottom:6px;">Welcome Back 👋</div>
      <div style="color:var(--tx2);margin-bottom:24px;font-size:13px;">Sign in with your phone number to continue</div>
      <div class="fg" id="fgp">
        <label class="fl">Phone Number</label>
        <div style="position:relative;">
          <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--tx3);font-size:16px;pointer-events:none;">📱</span>
          <input type="tel" id="phi" placeholder="+91 98765 43210" maxlength="15" style="padding-left:38px;">
        </div>
        <div class="fe">Please enter a valid phone number</div>
      </div>
      <button class="btn bp fw mt" onclick="sOtp()">Send OTP</button>
      <div style="margin:20px 0;text-align:center;position:relative;"><hr><span style="background:var(--bg);padding:0 12px;color:var(--tx3);font-size:12px;position:relative;z-index:1;">OR</span></div>
      <div style="background:rgba(64,202,215,.08);border:1px solid rgba(64,202,215,.25);border-radius:var(--r);padding:14px;text-align:center;">
        <div style="font-size:12px;color:var(--tx2);margin-bottom:10px;">🎭 <strong>Demo Mode</strong> — No OTP required</div>
        <div style="display:flex;gap:8px;flex-direction:column;">
          <button class="btn bo fw sm" onclick="dL('customer')">👤 Sign in as Customer</button>
          <button class="btn bo fw sm" onclick="dL('worker')">🔧 Sign in as Worker</button>
          <button class="btn bo fw sm" onclick="dL('employer')">🏢 Sign in as Employer</button>
          <button class="btn bg fw sm" onclick="dL('admin')">🛡 Sign in as Admin</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════ OTP ═══════════════════ -->
<div id="pot" class="pg">
  <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;">
    <div style="width:100%;max-width:420px;">
      <div style="text-align:center;margin-bottom:32px;">
        <div style="font-size:36px;font-weight:900;background:linear-gradient(135deg,var(--p),var(--sec));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">⚡ Kam Connect</div>
      </div>
      <div style="font-size:20px;font-weight:700;margin-bottom:6px;">Verify OTP 🔐</div>
      <div style="color:var(--tx2);margin-bottom:8px;font-size:13px;">Enter the 6-digit code sent to</div>
      <div id="opd" style="color:var(--p);font-weight:700;margin-bottom:24px;"></div>
      <div class="otp">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,0)" id="o0">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,1)" id="o1">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,2)" id="o2">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,3)" id="o3">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,4)" id="o4">
        <input type="number" class="oi" maxlength="1" oninput="oi(this,5)" id="o5">
      </div>
      <div id="oe" style="color:var(--er);font-size:12px;text-align:center;margin-top:8px;display:none;">Invalid OTP. Use <strong>123456</strong> for demo.</div>
      <button class="btn bp fw mt2" onclick="vOtp()">Verify &amp; Sign In</button>
      <div style="text-align:center;margin-top:16px;font-size:12px;color:var(--tx2);">Resend: <button class="btn bg sm" id="reb" onclick="rOtp()" style="display:inline-flex;">Resend (<span id="cd">30</span>s)</button></div>
      <div style="text-align:center;margin-top:10px;"><button class="btn bg sm" onclick="sP('pli')">← Change Number</button></div>
      <div style="background:rgba(64,202,215,.08);border:1px solid rgba(64,202,215,.2);border-radius:8px;padding:10px;margin-top:16px;font-size:12px;color:var(--tx2);text-align:center;">Demo OTP: <strong style="color:var(--p);">123456</strong></div>
    </div>
  </div>
</div>

<!-- ═══════════════════ MAIN APP ═══════════════════ -->
<div id="pap" class="pg" style="flex-direction:column;">

  <!-- Topbar -->
  <div class="topb">
    <div class="logo">⚡ Kam</div>
    <div class="sbx">
      <span style="color:var(--tx3);font-size:16px;">🔍</span>
      <input type="text" placeholder="Search services, workers, jobs…" id="tsi" onkeydown="if(event.key==='Enter')tS()">
    </div>
    <button class="btn bg sm" onclick="gT('tn')" style="padding:8px;border-radius:50%;min-width:0;position:relative;">
      🔔<span id="nd" style="position:absolute;top:6px;right:6px;width:8px;height:8px;background:var(--er);border-radius:50%;border:2px solid var(--bg);display:none;"></span>
    </button>
    <button class="btn bg sm" onclick="gT('tp')" style="padding:8px;border-radius:50%;min-width:0;font-size:18px;">👤</button>
  </div>

  <div class="pc" id="mc">

    <!-- ── HOME ── -->
    <div id="th" class="tc on">
      <div class="hs">
        <div style="display:flex;align-items:center;gap:6px;color:var(--tx2);font-size:13px;margin-bottom:14px;cursor:pointer;" onclick="oLoc()">
          <span style="color:var(--p);">📍</span><span id="ld">Pune, Maharashtra</span><span style="font-size:11px;">▾</span>
        </div>
        <div style="font-size:20px;font-weight:800;margin-bottom:4px;">Hello, <span id="gn">there</span> 👋</div>
        <div style="color:var(--tx2);font-size:13px;margin-bottom:14px;">What are you looking for today?</div>
        <div class="hs2">
          <input type="text" placeholder="Find services, workers or jobs near you" id="hsi" onkeydown="if(event.key==='Enter')hS()">
          <button style="background:var(--s2);border:1px solid var(--br);border-radius:8px;padding:9px 10px;font-size:16px;" onclick="vS()" title="Voice Search">🎤</button>
          <button class="btn bp sm" onclick="hS()">Search</button>
        </div>
        <div id="rsr" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;"></div>
      </div>
      <div style="padding:16px 16px 4px;font-size:15px;font-weight:700;">Quick Actions</div>
      <div class="qa">
