        <div id="aw" style="display:none;background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.3);border-radius:8px;padding:12px;margin-bottom:12px;font-size:12px;color:var(--wn);"></div>
        <button class="btn bp fw" id="asb" onclick="sApp()">✓ Submit Application</button>
        <div style="font-size:11px;color:var(--tx3);text-align:center;margin-top:8px;">Your profile and contact details will be shared with the employer</div>
      </div>
