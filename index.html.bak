        <div class="fc" onclick="fJC('Electrical',this)">Electrical</div>
        <div class="fc" onclick="fJC('Carpentry',this)">Carpentry</div>
        <div class="fc" onclick="fJC('Cleaning',this)">Cleaning</div>
