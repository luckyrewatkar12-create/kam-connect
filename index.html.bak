    <!-- ── POST JOB ── -->
    <div id="tpj" class="tc">
      <!-- Form -->
      <div id="pjf">
        <div style="padding:16px;">
          <button class="bkb" onclick="gB()">← Back</button>
          <div style="font-size:20px;font-weight:800;margin-bottom:4px;" id="pjt">Post a New Job</div>
          <div style="font-size:13px;color:var(--tx2);">Fill in details to attract the right workers</div>
        </div>
        <div style="padding:0 16px 24px;">
          <div class="fg" id="fgjt"><label class="fl">Job Title *</label><input type="text" id="jti" placeholder="e.g. Plumber needed for bathroom renovation"><div class="fe">Required</div></div>
          <div class="fg" id="fgjc"><label class="fl">Category *</label><select id="jca"><option value="">Select category…</option><option>Plumbing</option><option>Electrical</option><option>Carpentry</option><option>Painting</option><option>Construction</option><option>Cleaning</option><option>Mechanic</option><option>Delivery</option><option>Gardening</option><option>Home Repair</option><option>Other</option></select><div class="fe">Required</div></div>
          <div class="fg"><label class="fl">Description *</label><textarea id="jde" rows="4" placeholder="Describe the work, requirements, and skills needed…"></textarea></div>
          <div class="fg"><label class="fl">Required Skills (comma separated)</label><input type="text" id="jsk" placeholder="e.g. Plumbing, Pipe Fitting, Drain Cleaning"></div>
          <div class="g2">
            <div class="fg"><label class="fl">Workers Needed</label><input type="number" id="jwn" value="1" min="1"></div>
            <div class="fg"><label class="fl">Employment Type</label><select id="jty"><option>Full-time</option><option>Part-time</option><option>Daily Wage</option><option>Temporary</option><option>Contract</option><option>Apprenticeship</option></select></div>
          </div>
          <div class="g2">
            <div class="fg"><label class="fl">Min Wage (₹)</label><input type="number" id="jwi" placeholder="500"></div>
            <div class="fg"><label class="fl">Max Wage (₹)</label><input type="number" id="jwa" placeholder="800"></div>
          </div>
          <div class="fg"><label class="fl">Pay Frequency</label><select id="jfq"><option>Per Day</option><option>Per Week</option><option>Per Month</option><option>Per Job</option></select></div>
          <div class="g2">
            <div class="fg"><label class="fl">City *</label><input type="text" id="jci" value="Pune" placeholder="City"></div>
            <div class="fg"><label class="fl">Locality</label><input type="text" id="jlo" placeholder="Locality"></div>
          </div>
          <div class="fg"><label class="fl">Working Hours</label><input type="text" id="jhr" placeholder="8am–6pm, Mon–Sat"></div>
          <div class="g2">
            <div class="fg"><label class="fl">Start Date</label><input type="date" id="jsd"></div>
            <div class="fg"><label class="fl">Application Deadline</label><input type="date" id="jdl"></div>
          </div>
          <div class="fg"><label class="fl">Contact Phone</label><input type="tel" id="jph" placeholder="+91 98765 43210"></div>
          <div style="display:flex;gap:10px;margin-top:8px;">
            <button class="btn bg" style="flex:1;justify-content:center;" onclick="sDft()">Save Draft</button>
            <button class="btn bo" style="flex:1;justify-content:center;" onclick="pvJ()">Preview</button>
            <button class="btn bp" style="flex:1;justify-content:center;" onclick="pbJ()">Publish ✓</button>
          </div>
        </div>
      </div>
      <!-- Preview panel (hidden by default) -->
      <div id="pjpv" style="display:none;padding:20px 16px 32px;"></div>
    </div>

    <!-- ── APPLY ── -->
