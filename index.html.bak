      <div style="padding:0 16px 24px;">
        <div class="card mb2">
          <div style="font-size:13px;font-weight:700;color:var(--tx2);margin-bottom:12px;text-transform:uppercase;letter-spacing:.5px;">Account</div>
          <div class="ir" onclick="oEP()" style="cursor:pointer;"><span class="irl">Edit Profile</span><span style="color:var(--tx3);">→</span></div>
          <div class="ir" onclick="oLoc()" style="cursor:pointer;"><span class="irl">Location</span><span class="irv" id="sloc">Pune</span><span style="color:var(--tx3);">→</span></div>
